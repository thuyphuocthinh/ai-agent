# Application Environment Variables Example
# Copy this file to .env and fill in real values. Do NOT commit .env to version control.

NODE_ENV=development
PORT=3000

# --- Local infrastructure (docker-compose.local.yml: `pnpm local:up`) ---
# Postgres. Setting DB_HOST selects Postgres; leaving it unset selects SQLite
# (SQLite does NOT work with the current entities, so keep DB_HOST set).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=agent_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agent_db?schema=public"

# Redis (cache, BullMQ queues, cancellation, circuit breaker).
REDIS_HOST=localhost
REDIS_PORT=6379

# --- LLM (default model: gpt-4o-mini) ---
# Put your real key ONLY in your local .env (git-ignored), never in this file.
OPENAI_API_KEY=
# The code calls an OpenAI-compatible router at http://localhost:20128/v1 (9Router)
# by default. To call OpenAI directly, uncomment:
# AI_ROUTER_URL=https://api.openai.com/v1
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Tools (local testing) ---
# true = use the built-in mock `sql_server` agent (read_query, table_schema,
# execute_write_query) instead of real MCP servers. Writes change no data.
MOCK_TOOLS=false

# --- Compute Sandbox & Temporary Artifacts Storage ---
# Thư mục lưu trữ artifact tạm thời cho Direct-to-Disk và Python Compute Sandbox
ARTIFACTS_DIR=./.tmp/artifacts
# URL kết nối tới Python Compute Sandbox (mặc định trỏ tới container sandbox-compute)
AGENT_COMPUTE_URL=http://localhost:8088

# --- CLI web playground (`pnpm cli:web`) ---
# Where the CLI forwards /api/* (the core server). Default: http://127.0.0.1:3000
# CORE_URL=http://127.0.0.1:3000

# --- Orchestration Mode ---
# 'hybrid' (mặc định: Single Agent cho 85-90% prompt, tự động bật Supervisor khi song song/compute)
# 'single' (ép buộc 100% Single Agent)
# 'supervisor' (ép buộc 100% Multi-Agent Supervisor)
DEFAULT_ORCHESTRATION_MODE=hybrid

# --- Skill admin API (tạm, chưa có auth/RBAC) ---
# Header `x-admin-key` phải khớp giá trị này mới gọi được /api/skills.
# Để trống = từ chối mọi request (fail-closed).
SKILL_ADMIN_API_KEY=

# --- Skill auto-loading (nạp tự động nội dung skill theo độ khớp với prompt) ---
# Công tắc toàn cục: true (mặc định) / false. Tắt từng skill bằng metadata.autoLoad=false.
SKILL_AUTOLOAD_ENABLED=true
# Cosine tối thiểu giữa prompt và mô tả skill để được nạp (0 < x <= 1).
SKILL_AUTOLOAD_MIN_SCORE=0.42
# Tối đa số skill nạp mỗi lượt, tổng ký tự `instructions` tối đa, và timeout gọi embedding (ms).
SKILL_AUTOLOAD_MAX_SKILLS=2
SKILL_AUTOLOAD_MAX_CHARS=6000
SKILL_AUTOLOAD_TIMEOUT_MS=1500
