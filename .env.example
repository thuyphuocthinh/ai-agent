# Application Environment Variables Example
# Copy this file to .env and fill in real values. Do NOT commit .env to version control.

NODE_ENV=development
PORT=3000

# --- Local infrastructure (docker-compose.local.yml: `pnpm local:up`) ---
# Postgres. Setting DB_HOST selects Postgres; leaving it unset selects SQLite
# (SQLite does NOT work with the current entities, so keep DB_HOST set).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=agent_db

# Redis (cache, BullMQ queues, cancellation, circuit breaker).
REDIS_HOST=localhost
REDIS_PORT=6379

# --- LLM (default model: gpt-4o-mini) ---
# Put your real key ONLY in your local .env (git-ignored), never in this file.
OPENAI_API_KEY=
# The code calls an OpenAI-compatible router at http://localhost:20128/v1 (9Router)
# by default. To call OpenAI directly, uncomment:
# AI_ROUTER_URL=https://api.openai.com/v1
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Tools (local testing) ---
# true = use the built-in mock `sql_server` agent (read_query, table_schema,
# execute_write_query) instead of real MCP servers. Writes change no data.
MOCK_TOOLS=false

# --- CLI web playground (`pnpm cli:web`) ---
# Where the CLI forwards /api/* (the core server). Default: http://127.0.0.1:3000
# CORE_URL=http://127.0.0.1:3000
