# Application Environment Variables Example
# Copy this file to .env and fill in real values. Do NOT commit .env to version control.

NODE_ENV=development
PORT=3000

# --- Local infrastructure (docker-compose.local.yml: `pnpm local:up`) ---
# Postgres. Setting DB_HOST selects Postgres; leaving it unset selects SQLite
# (SQLite does NOT work with the current entities, so keep DB_HOST set).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=agent_db

# Redis (cache, BullMQ queues, cancellation, circuit breaker).
REDIS_HOST=localhost
REDIS_PORT=6379

# --- LLM (local runtime uses OpenAI gpt-4o-mini by default) ---
# Put your real key ONLY in your local .env (git-ignored), never in this file.
OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
