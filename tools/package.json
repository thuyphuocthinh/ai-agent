{
  "name": "@agent/tools",
  "version": "0.1.0",
  "description": "Agent Tools — MCP Client, OpenAPI, and Dynamic Tool Registry & Execution",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "agentic-io-parser": "^1.0.1",
    "agentic-openapi-parser": "^1.8.0",
    "ai": "^7.0.148",
    "axios": "^1.16.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ipaddr.js": "^2.4.0",
    "openai": "^6.45.0",
    "opossum": "^9.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/opossum": "^8.1.9",
    "jest": "^30.0.0",
    "openapi-types": "^12.1.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "diagnostics": false,
          "tsconfig": "<rootDir>/../tsconfig.jest.json"
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.pnpm/(ai|@ai-sdk\\+[^/@]+|@workflow\\+[^/@]+|eventsource-parser|@vercel\\+oidc)@|ai/|@ai-sdk/|@workflow/|eventsource-parser/|@vercel/oidc/))"
    ],
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@agent/tools(|/.*)$": "<rootDir>/$1",
      "^uuid$": "<rootDir>/../../core/src/common/__mocks__/uuid.js",
      "^nanoid$": "<rootDir>/../../core/src/common/__mocks__/nanoid.js"
    }
  }
}
