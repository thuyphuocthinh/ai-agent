{
  "name": "agents-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise AI Agent Monorepo (Core, Tools, CLI)",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "start:cli": "pnpm --filter @agent/cli start",
    "cli:web": "pnpm --filter @agent/cli web",
    "dev": "pnpm --parallel --filter @agent/core --filter @agent/cli run \"/^(start:dev|web)$/\"",
    "local:up": "docker compose -f docker-compose.local.yml up -d --wait",
    "local:down": "docker compose -f docker-compose.local.yml down",
    "local:reset": "docker compose -f docker-compose.local.yml down -v"
  }
}
