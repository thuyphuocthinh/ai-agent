datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ====================================================
// 1. IDENTITY & AUTHENTICATION
// ====================================================

enum UserRole {
  ADMIN
  STAFF
  USER
  GUEST
}

model User {
  id            String    @id @default(uuid(7)) @db.Uuid
  email         String?   @unique @db.VarChar(255)
  fullName      String?   @map("full_name") @db.VarChar(150)
  avatarUrl     String?   @map("avatar_url") @db.VarChar(500)
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true) @map("is_active")
  metadata      Json?     @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  auth          Auth?
  conversations Conversation[]
  auditLogs     AuditLog[]
  checkpoints   Checkpoint[]

  @@map("users")
}

model Auth {
  id                   String    @id @default(uuid(7)) @db.Uuid
  userId               String    @unique @map("user_id") @db.Uuid
  provider             String    @default("local") @db.VarChar(50) // local | telegram | google
  providerId           String?   @map("provider_id") @db.VarChar(100) // telegram_user_id hoặc oauth sub
  passwordHash         String?   @map("password_hash") @db.VarChar(255) // Null nếu đăng nhập qua Telegram
  refreshTokenHash     String?   @map("refresh_token_hash") @db.VarChar(255)
  tokenExpiresAt       DateTime? @map("token_expires_at") @db.Timestamptz
  lastLoginAt          DateTime? @map("last_login_at") @db.Timestamptz
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider, providerId])
  @@map("auths")
}

// ====================================================
// 2. CONVERSATIONS & CHAT MESSAGES
// ====================================================

enum ConversationState {
  AI_ACTIVE
  WAITING_FOR_APPROVAL
  HUMAN_TAKEOVER
}

model Conversation {
  id                  String             @id @default(uuid(7)) @db.Uuid
  userId              String             @map("user_id") @db.Uuid
  workflowId          String?            @map("workflow_id") @db.Uuid
  title               String?            @default("Cuộc trò chuyện mới") @db.VarChar(200)
  channelType         String             @default("web") @map("channel_type") @db.VarChar(50) // web | telegram | api
  channelId           String?            @map("channel_id") @db.VarChar(100) // Telegram chat_id
  workspaceId         String             @default("default") @map("workspace_id") @db.VarChar(100)
  botUserId           String?            @map("bot_user_id") @db.VarChar(100)
  state               ConversationState  @default(AI_ACTIVE)
  approvalMessageIds  String[]           @default([]) @map("approval_message_ids") // Checkpoints cần duyệt
  metadata            Json?              @default("{}")
  lastSeenAt          DateTime           @default(now()) @map("last_seen_at") @db.Timestamptz
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow            Workflow?          @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  messages            ConversationMessage[]
  checkpoints         Checkpoint[]
  memories            ConversationMemory[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([channelType, channelId])
  @@map("conversations")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model ConversationMessage {
  id              String       @id @default(uuid(7)) @db.Uuid
  conversationId  String       @map("conversation_id") @db.Uuid
  senderId        String?      @map("sender_id") @db.VarChar(100) // User ID hoặc Bot Slug
  role            MessageRole
  text            String       @db.Text
  isText          Boolean      @default(true) @map("is_text")
  attachments     Json?        @default("[]") // Mảng ảnh Base64 / URL phục vụ Vision
  modelUsed       String?      @map("model_used") @db.VarChar(100) // gemini-2.0-flash, gpt-4o-mini...
  inputTokens     Int?         @map("input_tokens")
  outputTokens    Int?         @map("output_tokens")
  costUsd         Float?       @map("cost_usd")
  latencyMs       Int?         @map("latency_ms")
  metadata        Json?        @default("{}") // Chứa rounds, toolCalls chi tiết để F5 render lại đầy đủ!
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Asc)])
  @@map("conversation_messages")
}

// ====================================================
// 3. HUMAN-IN-THE-LOOP (HITL) CHECKPOINTS
// ====================================================

enum CheckpointKind {
  APPROVAL
  CLARIFICATION
}

enum CheckpointStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model Checkpoint {
  id                      String           @id @default(uuid(7)) @db.Uuid
  replyMessageId          String           @unique @map("reply_message_id") @db.Uuid // Khóa tra cứu khi bấm duyệt
  userId                  String           @map("user_id") @db.Uuid
  conversationId          String           @map("conversation_id") @db.Uuid
  workspaceId             String           @default("default") @map("workspace_id") @db.VarChar(100)
  sessionType             String           @default("web") @map("session_type") @db.VarChar(50)
  originalPrompt          String           @map("original_prompt") @db.Text
  pendingTool             Json?            @map("pending_tool") // { provider, name, args }
  pendingTask             String           @map("pending_task") @db.Text
  kind                    CheckpointKind   @default(APPROVAL)
  riskLevel               String?          @map("risk_level") @db.VarChar(50)
  clarificationQuestion   String?          @map("clarification_question") @db.Text
  clarificationCandidates Json?            @map("clarification_candidates")
  selectedProvider        String?          @map("selected_provider") @db.VarChar(100)
  roundsSoFar             Json             @default("[]") @map("rounds_so_far") // Snapshot các bước đã hoàn tất
  remainingSteps          Json             @default("[]") @map("remaining_steps") // Các bước còn lại để resume
  history                 Json             @default("[]")
  status                  CheckpointStatus @default(PENDING)
  expiresAt               DateTime         @map("expires_at") @db.Timestamptz
  executionStartedAt      DateTime?        @map("execution_started_at") @db.Timestamptz
  toolExecutedAt          DateTime?        @map("tool_executed_at") @db.Timestamptz
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user                    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation            Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
  @@map("orchestration_checkpoints")
}

model TriggerClaim {
  id               String   @id @default(uuid(7)) @db.Uuid
  triggerMessageId String   @unique @map("trigger_message_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("orchestration_trigger_claims")
}

// ====================================================
// 4. WORKFLOWS & KNOWLEDGE MEMORY
// ====================================================

model Workflow {
  id                  String         @id @default(uuid(7)) @db.Uuid
  slug                String         @unique @db.VarChar(100) // human-readable slug: customer-support, hotel-booking
  name                String         @db.VarChar(150)
  description         String?        @db.Text
  systemPrompt        String         @map("system_prompt") @db.Text
  model               String?        @default("gemini-2.0-flash") @db.VarChar(100)
  tools               String[]       @default([]) // Danh sách công cụ được phép dùng (Least Privilege)
  requireApprovalFor  String[]       @default([]) @map("require_approval_for")
  maxLoops            Int?           @default(5) @map("max_loops")
  isActive            Boolean        @default(true) @map("is_active")
  metadata            Json?          @default("{}")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  conversations       Conversation[]

  @@map("workflows")
}

model ConversationMemory {
  id              String       @id @default(uuid(7)) @db.Uuid
  conversationId  String       @map("conversation_id") @db.Uuid
  sourceMessageId String       @map("source_message_id") @db.Uuid
  tool            String       @db.VarChar(100)
  content         String       @db.Text
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("conversation_memories")
}

model Skill {
  id           String   @id(map: "PK_orchestration_skills") @default(uuid(7)) @db.Uuid
  tenantId     String   @default("default") @map("tenant_id") @db.VarChar(100)
  slug         String   @db.VarChar(100)
  name         String   @db.VarChar(150)
  description  String   @db.Text
  instructions String   @db.Text
  tools        String[] @default([])
  tags         String[] @default([])
  isActive     Boolean  @default(true) @map("is_active")
  metadata     Json     @default("{}") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, slug], map: "UQ_orchestration_skills_tenant_slug")
  @@index([tenantId, isActive], map: "IDX_orchestration_skills_tenant_active")
  @@map("orchestration_skills")
}

model DynamicProvider {
  id             String    @id(map: "PK_orchestration_dynamic_providers")
  userId         String    @map("user_id")
  name           String
  specUrl        String    @map("spec_url") @db.Text
  description    String?   @db.Text
  accessToken    String?   @map("access_token") @db.Text
  authType       String    @default("BEARER") @map("auth_type")
  refreshToken   String?   @map("refresh_token") @db.Text
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz
  authConfig     Json?     @map("auth_config") @db.JsonB
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId], map: "idx_dyn_prov_user_id")
  @@map("orchestration_dynamic_providers")
}

// ====================================================
// 5. SECURITY & AUDIT TRAIL (IMMUTABLE)
// ====================================================

enum AuditStatus {
  EXECUTED
  BLOCKED
  PENDING_APPROVAL
  REJECTED
}

model AuditLog {
  id             String      @id @default(uuid(7)) @db.Uuid
  timestamp      DateTime    @default(now()) @db.Timestamptz
  userId         String?     @map("user_id") @db.Uuid
  conversationId String?     @map("conversation_id") @db.Uuid
  provider       String      @db.VarChar(100)
  toolName       String      @map("tool_name") @db.VarChar(100)
  actionType     String      @map("action_type") @db.VarChar(50)
  fingerprint    String      @db.VarChar(64) // SHA-256 canonical hash (chính xác 64 hex chars)
  inputArgs      Json        @map("input_args")
  resultPreview  String?     @map("result_preview") @db.Text
  verdict        String      @db.VarChar(50) // ALLOW | DENY | REQUIRE_APPROVAL | ESCALATE
  citedRuleId    String?     @map("cited_rule_id") @db.VarChar(100)
  status         AuditStatus @default(EXECUTED)
  metadata       Json?       @default("{}")

  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([timestamp(sort: Desc)])
  @@index([userId, timestamp(sort: Desc)])
  @@index([fingerprint])
  @@index([citedRuleId])
  @@map("audit_logs")
}
