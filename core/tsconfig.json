{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@agent/core": [
        "src/index.ts"
      ],
      "@agent/core/*": [
        "src/*"
      ],
      "@agent/core/entity/*": [
        "src/infrastructure/database/entities/*"
      ],
      "@agent/core/entity": [
        "src/infrastructure/database/entities/index.ts"
      ],
      "@agent/core/dto/*": [
        "src/contracts/dtos/*"
      ],
      "@agent/core/dto": [
        "src/contracts/dtos/index.ts"
      ],
      "@agent/core/loop/*": [
        "src/engine/loop/*"
      ],
      "@agent/tools": [
        "../tools/src/index.ts"
      ],
      "@agent/tools/*": [
        "../tools/src/*"
      ],
      "agentic-openapi-parser/*": [
        "node_modules/agentic-openapi-parser/dist/*/index.js"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts"
  ]
}
