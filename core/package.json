{
  "name": "@agent/core",
  "version": "0.1.0",
  "description": "Agent Core — Enterprise AI Agent Orchestration Engine",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "lint": "eslint \"{src}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@apidevtools/swagger-parser": "^12.1.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/websockets": "^11.2.7",
    "@prisma/client": "^6.19.3",
    "agentic-io-parser": "^1.0.1",
    "agentic-openapi-parser": "^1.8.0",
    "ai": "^7.0.148",
    "axios": "^1.16.1",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^5.76.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "ioredis": "^5.10.1",
    "ipaddr.js": "^2.4.0",
    "langsmith": "^0.7.14",
    "nest-winston": "^2.0.0",
    "openai": "^6.45.0",
    "opossum": "^9.0.0",
    "pg": "^8.20.0",
    "pgvector": "^0.3.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "speckit-ai": "latest",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.26",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/opossum": "^8.1.9",
    "jest": "^30.0.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "diagnostics": false,
          "tsconfig": "<rootDir>/../tsconfig.jest.json"
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.pnpm/(ai|@ai-sdk\\+[^/@]+|@workflow\\+[^/@]+|eventsource-parser|@vercel\\+oidc)@|ai/|@ai-sdk/|@workflow/|eventsource-parser/|@vercel/oidc/))"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@agent/core/entity/(.*)$": "<rootDir>/infrastructure/database/entities/$1",
      "^@agent/core/dto/(.*)$": "<rootDir>/contracts/dtos/$1",
      "^@agent/core/loop/(.*)$": "<rootDir>/engine/loop/$1",
      "^@agent/core(|/.*)$": "<rootDir>/$1",
      "^@agent/tools(|/.*)$": "<rootDir>/../../tools/src/$1",
      "^nanoid$": "<rootDir>/common/__mocks__/nanoid.js",
      "^uuid$": "<rootDir>/common/__mocks__/uuid.js"
    }
  }
}
